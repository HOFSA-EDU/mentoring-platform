# PostgreSQL connection used by Prisma and the application.
DATABASE_URL="postgresql://mentoring:mentoring_dev@localhost:5432/mentoring?schema=public"

# Generate a unique production value with: npx auth secret
AUTH_SECRET="replace-with-a-unique-secret-of-at-least-32-characters"

# Local defaults for: docker compose -f docker-compose.dev.yml up -d
POSTGRES_DB="mentoring"
POSTGRES_USER="mentoring"
POSTGRES_PASSWORD="mentoring_dev"
