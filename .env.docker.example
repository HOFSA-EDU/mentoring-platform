# Copy to .env.docker. Always use: docker compose --env-file .env.docker ...
# Full setup, HTTPS, updates and backups: docs/DOCKER_DEPLOYMENT.md

COMPOSE_PROJECT_NAME=bts-mentoring-platform-production
IMAGE_TAG=local

# Use letters, digits and underscores for database/user names.
POSTGRES_DB=mentoring
POSTGRES_USER=mentoring
# Required: generate a random hex password (URL-safe), see deployment guide.
POSTGRES_PASSWORD=

# Required: independent random secret, at least 32 characters.
AUTH_SECRET=
# Public browser origin; use https://mentoring.example.org in production.
AUTH_URL=http://localhost:3000

# Default: reachable only on this host, ready for a host reverse proxy.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# Only read by the explicit bootstrap service. Remove after first-admin setup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
